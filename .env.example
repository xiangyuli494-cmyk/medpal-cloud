# ---- 运行模式 ----
# offline = 纯本地 FakeLLM + BM25；openai/modelarts/pangu = 走云端模型
MEDPAL_LLM=offline
MEDPAL_LLM_MODEL=
MEDPAL_LLM_BASE_URL=
MEDPAL_LLM_API_KEY=

# 存储后端：留空=按 HUAWEI_GAUSSDB_DSN 自动判断；sqlite | gaussdb
MEDPAL_DB_BACKEND=

# ---- 本地数据位置（默认 data/ 下）----
MEDPAL_DATA_DIR=
MEDPAL_DB=
MEDPAL_REPORT_DIR=
MEDPAL_LEXICON=
MEDPAL_TOP_K=8
# 资产入知识库时写入的 base 名（只在 payload 里做标记，不连服务）
MEDPAL_KB_BASE=
MEDPAL_MAX_HOPS=2

# ---- 华为云 ----
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_REGION=cn-north-4
HUAWEI_PROJECT_ID=
HUAWEI_OBS_BUCKET=
HUAWEI_GAUSSDB_DSN=
HUAWEI_MODEL_ENDPOINT=
HUAWEI_MODEL_NAME=
HUAWEI_KOOSEARCH_ENDPOINT=
