# ---- 运行模式 ----
# offline = 纯本地 FakeLLM + BM25；openai/modelarts/pangu = 走云端模型
MEDPAL_LLM=offline
MEDPAL_LLM_MODEL=
MEDPAL_LLM_BASE_URL=
MEDPAL_LLM_API_KEY=

# 存储后端：留空=按 HUAWEI_GAUSSDB_DSN 自动判断；sqlite | gaussdb
MEDPAL_DB_BACKEND=

# ---- 本地数据位置（默认 data/ 下）----
MEDPAL_DATA_DIR=
MEDPAL_DB=
MEDPAL_REPORT_DIR=
MEDPAL_LEXICON=
MEDPAL_TOP_K=8
# 资产入知识库时写入的 base 名（只在 payload 里做标记，不连服务）
MEDPAL_KB_BASE=
MEDPAL_MAX_HOPS=2

# ---- 华为云 ----
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_REGION=cn-north-4
HUAWEI_PROJECT_ID=
HUAWEI_OBS_BUCKET=
# 数据库连接串：通用名优先，旧名 HUAWEI_GAUSSDB_DSN 仍兼容
MEDPAL_DB_DSN=
HUAWEI_GAUSSDB_DSN=
# MaaS 端点（独立公网域名，不是 region 端点）；拿到 key 后这三行一填即可切云端模型
# 通没通：python scripts/smoke_llm.py --strict
# 实测：ModelArts Studio 平台侧没有对话模型，改用任意 OpenAI 兼容端点（DeepSeek 已验证）：
#   MEDPAL_LLM=openai
#   MEDPAL_LLM_BASE_URL=https://api.deepseek.com/v1
#   MEDPAL_LLM_MODEL=deepseek-chat
#   MEDPAL_LLM_API_KEY=<你的 key>      # 只写 .env.local（.gitignore 已挡），永不入库
HUAWEI_MODEL_ENDPOINT=
HUAWEI_MODEL_NAME=
HUAWEI_MODEL_API_KEY=
HUAWEI_KOOSEARCH_ENDPOINT=
