# 华为云真实配置模板：复制为 .env.huawei 后填值；.env.huawei 永不入库。
#   cp .env.huawei.example .env.huawei
# 值全部留空，填完不要提交。

# ---- 数据库：至少填一个，MEDPAL_DB_DSN 优先 ----
MEDPAL_DB_DSN=
# 旧名，仍兼容
HUAWEI_GAUSSDB_DSN=

# ---- IAM 子账号密钥（别用主账号）----
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_REGION=cn-north-4
HUAWEI_PROJECT_ID=

# ---- OBS ----
HUAWEI_OBS_BUCKET=
# 云上留空按 region 拼；本地 MinIO 填 http://127.0.0.1:9000
HUAWEI_OBS_ENDPOINT=

# ---- ModelArts Studio ----
HUAWEI_MODEL_ENDPOINT=
HUAWEI_MODEL_NAME=

# ---- KooSearch（可降级，留空则用本地 BM25）----
HUAWEI_KOOSEARCH_ENDPOINT=